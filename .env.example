# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Public (safe in the browser). NEXT_PUBLIC_ vars are inlined into the client
# bundle at build time, so only ever put publishable/anon keys here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-anon-key>
NEXT_PUBLIC_SUPABASE_PROJECT_ID=<project-ref>

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
#
# GROQ_API_KEY is read by the chat edge function via Deno.env.get("GROQ_API_KEY"),
# so it must be set as a Supabase secret to take effect in production:
#
#   npx supabase login
#   npx supabase link --project-ref <project-ref>
#   npx supabase secrets set GROQ_API_KEY=<your-groq-key>
#   npx supabase functions deploy chat
#
# The value below is only used for local `supabase functions serve`.
# ---------------------------------------------------------------------------
GROQ_API_KEY=<your-groq-api-key>
